          <rolloverIcon value="resources/sprites/botones/BotonSalir_Selecc.png"/>
          <rolloverSelectedIcon value="resources/sprites/botones/BotonSalir_Selecc.png"/>
          <selectedIcon value="resources/sprites/botones/BotonSalir_Selecc.png"/>
          <text value=""/>
        </properties>
      </component>
    </children>
  </grid>
