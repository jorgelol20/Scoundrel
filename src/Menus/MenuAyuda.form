            <children>
              <component id="df77e" class="javax.swing.JTextPane" binding="enScoundrelTuObjetivoTextPane" default-binding="true">
                <constraints>
                  <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="50"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-16760815"/>
                  <caretColor color="-15877376"/>
                  <editable value="false"/>
                  <font size="16" style="1"/>
                  <foreground color="-1"/>
                  <margin top="10" left="10" bottom="10" right="10"/>
                  <text value="En Scoundrel tu objetivo es derrotar a todos los enemigos sin morir en el intento. &#10;Para ello, contarás con diversas armas y curaciones a lo largo de la run que te facilitarán en gran medida la tarea.&#10;Pero no te confies, aunque cuentes con estas&#10;mejoras, este juego supone un desafío de estratégia&#10;que no muchos pueden superar"/>
                </properties>
              </component>
              <component id="fa99c" class="javax.swing.JLabel">
                <constraints>
                  <grid row="1" column="2" row-span="5" col-span="5" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <icon value="resources/sprites/logoTemporal.png"/>
                  <text value=""/>
                </properties>
              </component>
              <component id="34d18" class="javax.swing.JTextPane">
                <constraints>
                  <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="10" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-16760815"/>
                  <caretColor color="-15877376"/>
                  <editable value="false"/>
                  <font name="Arial Black" size="28"/>
                  <foreground color="-1"/>
                  <text value="Modo Normal"/>
                </properties>
              </component>
              <component id="69c4f" class="javax.swing.JTextPane" default-binding="true">
                <constraints>
                  <grid row="5" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="50"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-16760815"/>
                  <caretColor color="-15877376"/>
                  <editable value="false"/>
                  <font size="16" style="1"/>
                  <foreground color="-1"/>
                  <margin top="10" left="10" bottom="10" right="10"/>
                  <text value="El modo QUEST es una variación del modo normal donde tu objetivo es ganar 10 partidas seguidas sin ser derrotado. ¡Pero no te preocupes! Este modo cuenta con modificadores y mejoras que harán de la experiencia algo más desafiante y divertida para quien busca desafios."/>
                </properties>
              </component>
              <component id="68595" class="javax.swing.JTextPane">
                <constraints>
                  <grid row="4" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="10" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <background color="-16760815"/>
                  <caretColor color="-15877376"/>
                  <editable value="false"/>
                  <font name="Arial Black" size="28"/>
                  <foreground color="-1"/>
                  <text value="Modo Quest"/>
                </properties>
              </component>
              <component id="ba7be" class="javax.swing.JTextPane" default-binding="true">
                <constraints>
                  <grid row="3" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                    <preferred-size width="150" height="50"/>
                  </grid>
                </constraints>
                <properties>
                  <background color="-16760815"/>
                  <caretColor color="-15877376"/>
                  <editable value="false"/>
                  <font size="16" style="1"/>
                  <foreground color="-1"/>
                  <margin top="10" left="10" bottom="10" right="10"/>
                  <text value="El modo normal o clásico es a una sola ronda sin ningún tipo de mejora ni modificación donde tendrás que acabar con todos los enemigos con la herramientas base del juego siendo una muy buena experiencia para iniciarse."/>
                </properties>
              </component>
